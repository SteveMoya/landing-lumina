---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe." noindex>
  <section class="flex min-h-[80svh] flex-col items-center justify-center px-6 text-center">
    <p class="font-display text-7xl font-semibold tracking-tight text-aurum">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight text-cloud">
      Aquí solo hay silencio.
    </h1>
    <p class="mt-3 max-w-md leading-relaxed text-silver">
      La página que buscas no existe o se ha movido.
    </p>
    <Button href="/" class="mt-8">Volver al inicio</Button>
  </section>
</BaseLayout>
