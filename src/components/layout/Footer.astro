---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="border-t border-white/10 bg-stone">
  <div class="container-lumina py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-5">
        <Logo />
        <p class="max-w-xs text-sm leading-relaxed text-silver">
          El silencio es un lujo. Diseñamos auriculares para quienes valoran escuchar lo que
          importa.
        </p>
        <div class="flex gap-3">
          {
            site.socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="inline-flex h-10 w-10 items-center justify-center rounded-full text-silver ring-1 ring-white/10 transition-colors duration-200 hover:text-aurum hover:ring-aurum/40"
              >
                <Icon name={s.icon} size={18} />
              </a>
            ))
          }
        </div>
      </div>

      {
        site.footer.columns.map((column) => (
          <nav aria-label={column.title}>
            <h3 class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-cloud">
              {column.title}
            </h3>
            <ul class="space-y-3">
              {
                column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-silver transition-colors duration-200 hover:text-cloud"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        ))
      }

      <div class="flex flex-col gap-4">
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-cloud">
          Contacto
        </h3>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 text-sm text-silver transition-colors duration-200 hover:text-cloud"
        >
          <Icon name="mail" size={16} class="text-aurum" />
          {site.email}
        </a>
        <p class="text-xs leading-relaxed text-silver/60">
          Respondemos en menos de 24 horas, de lunes a viernes.
        </p>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-silver/70 sm:flex-row"
    >
      <p>
        © {new Date().getFullYear()} {site.name}. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href={site.legal.privacy} class="transition-colors hover:text-cloud">
          Aviso de privacidad
        </a>
        <a href={site.legal.terms} class="transition-colors hover:text-cloud">
          Términos
        </a>
      </div>
    </div>
  </div>
</footer>
