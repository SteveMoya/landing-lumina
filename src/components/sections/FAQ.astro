---
import { faqs } from '../../data/faqs';
import Section from '../ui/Section.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="preguntas" ariaLabelledBy="faq-title" background="dark">
  <div class="mx-auto max-w-2xl text-center">
    <Badge class="mb-5">Preguntas frecuentes</Badge>
    <h2
      id="faq-title"
      class="font-display text-3xl font-semibold tracking-tight text-cloud sm:text-4xl md:text-5xl"
    >
      Todo lo que quieres saber
    </h2>
  </div>

  <div class="mx-auto mt-14 max-w-3xl space-y-3">
    {
      faqs.map((faq) => (
        <details
          class="group rounded-2xl bg-white/[0.03] ring-1 ring-white/10 transition-colors duration-200 open:ring-aurum/30"
        >
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-display text-base font-medium text-cloud [&::-webkit-details-marker]:hidden"
          >
            {faq.question}
            <span
              class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/5 text-silver transition-transform duration-300 ease-lumina group-open:rotate-45"
            >
              <Icon name="plus" size={16} />
            </span>
          </summary>
          <p class="px-6 pb-6 text-sm leading-relaxed text-silver">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
