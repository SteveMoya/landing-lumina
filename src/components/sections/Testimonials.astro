---
import { testimonials } from '../../data/testimonials';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="opiniones" ariaLabelledBy="testimonials-title">
  <div class="mx-auto max-w-2xl text-center">
    <Badge class="mb-5">Opiniones</Badge>
    <h2
      id="testimonials-title"
      class="font-display text-3xl font-semibold tracking-tight text-cloud sm:text-4xl md:text-5xl"
    >
      Quienes ya encontraron su silencio
    </h2>
  </div>

  <ul class="mt-16 grid gap-6 md:grid-cols-3">
    {
      testimonials.map((testimonial) => (
        <li data-reveal>
          <Card class="flex h-full flex-col">
            <div
              class="flex gap-1 text-aurum"
              role="img"
              aria-label="Valoración: 5 de 5 estrellas"
            >
              {Array.from({ length: 5 }).map(() => <Icon name="star" size={14} />)}
            </div>
            <blockquote
              class="mt-4 flex-1 text-[15px] leading-relaxed text-cloud/90"
            >
              “{testimonial.quote}”
            </blockquote>
            <figcaption class="mt-6 border-t border-white/10 pt-4">
              <p class="font-display text-sm font-semibold text-cloud">
                {testimonial.name}
              </p>
              <p class="mt-0.5 text-xs text-silver">{testimonial.role}</p>
            </figcaption>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>
