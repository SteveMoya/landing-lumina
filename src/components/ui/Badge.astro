---
interface Props {
  class?: string;
  tone?: 'aurum' | 'neutral';
}

const { tone = 'neutral', class: className } = Astro.props;

const tones = {
  aurum: 'bg-aurum/10 text-aurum ring-1 ring-aurum/30',
  neutral: 'bg-white/5 text-silver ring-1 ring-white/10',
} as const;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium uppercase tracking-wider',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
