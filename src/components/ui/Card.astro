---
interface Props {
  class?: string;
  padded?: boolean;
  as?: 'article' | 'div' | 'li';
}

const { padded = true, as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={[
    'relative rounded-2xl bg-graphite/60 shadow-card ring-1 ring-white/10 backdrop-blur-sm',
    padded && 'p-8',
    className,
  ]}
>
  <slot />
</Tag>
