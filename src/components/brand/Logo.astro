---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Lumina — inicio"
  class:list={['group inline-flex items-center gap-2.5', className]}
>
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <circle cx="14" cy="14" r="12.5" stroke="var(--color-aurum)" stroke-width="1.5" opacity="0.9" />
    <circle cx="14" cy="14" r="5" fill="var(--color-aurum)" />
    <circle cx="14" cy="14" r="1.8" fill="var(--color-stone)" />
  </svg>
  <span
    class="font-display text-xl font-semibold tracking-tight text-cloud transition-colors duration-200 group-hover:text-aurum"
  >
    Lumina
  </span>
</a>
